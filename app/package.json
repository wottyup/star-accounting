{
  "name": "wotty-stark-web",
  "private": true,
  "version": "0.26.0-dev.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "node scripts/mobile-dev.mjs",
    "sync:android": "node scripts/sync-android.mjs",
    "build": "node scripts/build.mjs web",
    "start": "next start -H 0.0.0.0 -p 12366",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/**/*.test.mjs",
    "test:lan-update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/publish-lan-update.test.mjs",
    "apk": "node scripts/build.mjs apk dev web",
    "apk:linux": "node scripts/build.mjs apk dev web",
    "apk:ktweb": "node scripts/build.mjs apk dev ktweb",
    "apk:ktweb:linux": "node scripts/build.mjs apk dev ktweb"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "echarts": "^6.1.0",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
